{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "song",
  "account_id": "92c143b104fca6981f7219a50d672889",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "sonforu.work", "custom_domain": true }
  ],
  "vars": {
    "LOCAL_DEV": "0",
    "R2_ACCOUNT_ID": "92c143b104fca6981f7219a50d672889",
    "R2_BUCKET_NAME": "song-media"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "song-db",
      "database_id": "e211cf9d-14eb-4fed-92e8-5349421c1613",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "song-media" }
  ]
}
